<?xml version="1.0" encoding="utf-8"?>
<!-- One screen, three tabs (Clean · Recent · Settings) switched by the bottom bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/tab_clean"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium" />
                <!-- 1. Input -->
                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/input"
                    android:text="@string/input_label" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="58dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="16dp"
                        android:paddingEnd="100dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:hint="@string/input_hint"
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions"
                        android:imeOptions="actionDone"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:layout_gravity="end|top"
                        android:layout_marginEnd="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/clear"
                            style="@style/IconButton"
                            android:contentDescription="@string/clear_input"
                            android:src="@drawable/ic_clear"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/paste"
                            style="@style/IconButton"
                            android:contentDescription="@string/paste"
                            android:src="@drawable/ic_paste" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 2. Country for local numbers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/country_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/country"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_chip"
                        android:drawableEnd="@drawable/ic_arrow_drop_down"
                        android:drawablePadding="2dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- 3. Result -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/output_label"
                        android:textColor="@color/on_accent_container"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:alpha="0.8" />

                    <TextView
                        android:id="@+id/output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_text_button"
                        android:accessibilityLiveRegion="polite"
                        android:breakStrategy="simple"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:text="@string/output_placeholder"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:minHeight="36dp"
                        android:background="@drawable/bg_text_button"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/on_accent_container"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/fix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Output format -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="-6dp"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/include_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:minHeight="44dp"
                            android:buttonTint="@color/accent"
                            android:text="@string/include_code"
                            android:textColor="@color/on_accent_container"
                            android:textSize="14sp" />

                        <CheckBox
                            android:id="@+id/include_plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:buttonTint="@color/accent"
                            android:text="@string/include_plus"
                            android:textColor="@color/on_accent_container"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/copy"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button"
                            android:drawableStart="@drawable/ic_copy"
                            android:drawableTint="@color/button_text"
                            android:drawablePadding="10dp"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:stateListAnimator="@null"
                            android:text="@string/copy"
                            android:textAllCaps="false"
                            android:textColor="@color/button_text"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium" />

                        <Button
                            android:id="@+id/send"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_tonal"
                            android:contentDescription="@string/send_cd"
                            android:drawableStart="@drawable/ic_call"
                            android:drawablePadding="8dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="20dp"
                            android:stateListAnimator="@null"
                            android:text="@string/send"
                            android:textAllCaps="false"
                            android:textColor="@color/on_accent_container"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />

                        <ImageButton
                            android:id="@+id/share"
                            style="@style/IconButton"
                            android:layout_width="48dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@string/share"
                            android:src="@drawable/ic_share"
                            android:tint="@color/on_accent_container" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tab_recent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/recent"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium" />

                    <Button
                        android:id="@+id/clear_history"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="64dp"
                        android:background="@drawable/bg_text_button"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:stateListAnimator="@null"
                        android:text="@string/clear"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/history_empty"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_list"
                    android:clipToOutline="true"
                    android:divider="@drawable/divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="4dp"
                    android:text="@string/history_tip"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:accessibilityHeading="true"
                    android:text="@string/settings"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:accessibilityHeading="true"
                    android:text="@string/section_send"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_list"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/setting_amount"
                        android:text="@string/setting_amount"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <EditText
                        android:id="@+id/setting_amount"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:hint="@string/setting_amount_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="9"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/setting_amount_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/setting_amount_help"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <View android:layout_width="match_parent" android:layout_height="6dp" />
                    <CheckBox
                        android:id="@+id/setting_ask_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:minHeight="48dp"
                        android:buttonTint="@color/accent"
                        android:text="@string/setting_ask_amount"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="26dp"
                        android:text="@string/setting_ask_amount_help"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/divider" />
                    <CheckBox
                        android:id="@+id/setting_direct_dial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:minHeight="48dp"
                        android:buttonTint="@color/accent"
                        android:text="@string/setting_direct_dial"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="26dp"
                        android:text="@string/setting_direct_dial_help"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/divider" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/setting_ussd"
                        android:text="@string/setting_ussd"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/setting_ussd"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:fontFamily="monospace"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="text|textNoSuggestions"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/setting_ussd_reset"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_text_button"
                            android:minWidth="56dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:stateListAnimator="@null"
                            android:text="@string/setting_ussd_reset"
                            android:textAllCaps="false"
                            android:textColor="@color/accent"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/setting_ussd_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/setting_ussd_help"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:accessibilityHeading="true"
                    android:text="@string/section_widget"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_list"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <CheckBox
                        android:id="@+id/setting_auto_copy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:minHeight="48dp"
                        android:buttonTint="@color/accent"
                        android:text="@string/setting_auto_copy"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="26dp"
                        android:text="@string/setting_auto_copy_help"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/divider" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/nav_clean"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/tab_clean"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/nav_pill">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_clean"
                    android:tint="@color/nav_icon" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:text="@string/tab_clean"
                android:textColor="@color/nav_label"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_recent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/tab_recent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/nav_pill">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_recent"
                    android:tint="@color/nav_icon" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:text="@string/tab_recent"
                android:textColor="@color/nav_label"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/tab_settings"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/nav_pill">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_settings"
                    android:tint="@color/nav_icon" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:text="@string/tab_settings"
                android:textColor="@color/nav_label"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
