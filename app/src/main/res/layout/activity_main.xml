<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Input -->
        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/input"
            android:text="@string/input_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="@drawable/bg_field"
                android:paddingStart="16dp"
                android:paddingEnd="100dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:hint="@string/input_hint"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:imeOptions="actionDone"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/clear"
                    style="@style/IconButton"
                    android:contentDescription="@string/clear_input"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/paste"
                    style="@style/IconButton"
                    android:contentDescription="@string/paste"
                    android:src="@drawable/ic_paste" />
            </LinearLayout>
        </FrameLayout>

        <!-- Country code -->
        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/country"
            android:text="@string/country_label" />

        <Spinner
            android:id="@+id/country"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_spinner_ripple"
            android:popupBackground="@drawable/bg_popup"
            android:popupElevation="8dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/country_help"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Result -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/output_label"
                android:textColor="@color/on_accent_container"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_text_button"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:textColor="@color/text_primary"
                android:textIsSelectable="false"
                android:textSize="30sp"
                android:breakStrategy="simple"
                android:text="@string/output_placeholder" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copy"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawableTint="@color/button_text"
                    android:drawablePadding="10dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/copy"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageButton
                    android:id="@+id/share"
                    style="@style/IconButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/share"
                    android:src="@drawable/ic_share"
                    android:tint="@color/on_accent_container" />
            </LinearLayout>
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/recent"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/clear_history"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="64dp"
                android:background="@drawable/bg_text_button"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="@string/clear"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/history_empty"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_list"
            android:clipToOutline="true"
            android:divider="@drawable/divider"
            android:showDividers="middle"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
