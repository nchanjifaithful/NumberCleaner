<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: framework widgets only, no theme attributes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_meta_row"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/w_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_warn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/warning"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_paste"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_paste"
            android:contentDescription="@string/widget_paste_cd"
            android:scaleType="center"
            android:src="@drawable/ic_widget_paste" />

        <LinearLayout
            android:id="@+id/w_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_widget_box"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/w_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_empty"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/w_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_copybtn"
            android:contentDescription="@string/copy"
            android:scaleType="center"
            android:src="@drawable/ic_widget_copy" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_code"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_wchip_on"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_plus"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_wchip_on"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/w_recent_1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_recent_1_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_copy_small" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_recent_2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_recent_2_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_copy_small" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_recent_3"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_recent_3_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_copy_small" />
    </LinearLayout>
</LinearLayout>
