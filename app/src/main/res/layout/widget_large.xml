<?xml version="1.0" encoding="utf-8"?>
<!-- Tall widget: header + up to 3 more recent numbers (tap a row to copy it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_text"
            android:contentDescription="@string/widget_open_cd"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_empty"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_copy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_widget_copy"
            android:contentDescription="@string/copy"
            android:scaleType="center"
            android:src="@drawable/ic_widget_copy" />

        <ImageButton
            android:id="@+id/widget_clean"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_new"
            android:contentDescription="@string/widget_clean_cd"
            android:scaleType="center"
            android:src="@drawable/ic_widget_clean" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/widget_recent_1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_recent_1_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_copy_small" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_recent_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_recent_2_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_copy_small" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_recent_3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_recent_3_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_copy_small" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_no_more"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:text="@string/widget_no_more"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />
</LinearLayout>
