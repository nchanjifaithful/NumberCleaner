<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: framework widgets only, no theme attributes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_box"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_box"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/w_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/w_paste"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wbtn_tonal"
            android:contentDescription="@string/widget_paste_cd"
            android:scaleType="center"
            android:src="@drawable/ic_widget_paste" />
        <ImageButton
            android:id="@+id/w_copy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wbtn_filled"
            android:contentDescription="@string/copy"
            android:scaleType="center"
            android:src="@drawable/ic_widget_copy" />
        <ImageButton
            android:id="@+id/w_send"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_wbtn_tonal"
            android:contentDescription="@string/send_cd"
            android:scaleType="center"
            android:src="@drawable/ic_widget_send" />
    </LinearLayout>
</LinearLayout>
