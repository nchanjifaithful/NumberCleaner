<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only framework layouts/widgets, no theme attributes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_text"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_empty"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_copy"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_copy"
        android:contentDescription="@string/copy"
        android:scaleType="center"
        android:src="@drawable/ic_widget_copy" />

    <ImageButton
        android:id="@+id/widget_new"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_new"
        android:contentDescription="@string/widget_new_cd"
        android:scaleType="center"
        android:src="@drawable/ic_widget_edit" />
</LinearLayout>
